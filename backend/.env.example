# Copy to backend/.env for local development. Never commit real values.
APP_ENV=development            # production on Render
PORT=8080
DB_PATH=postgres://kladovki:kladovki_secret@localhost:5432/kladovki?sslmode=disable
JWT_SECRET=change-me-at-least-32-characters-long
JWT_TTL_HOURS=24

# ApiPay (Kaspi invoices). Webhook URL to set in ApiPay: https://<host>/api/v1/payments/webhook
APIPAY_KEY=
APIPAY_BASE_URL=https://api.apipay.kz/api
APIPAY_WEBHOOK_SECRET=         # "Создать секретный ключ подписи" in ApiPay; required outside development
APIPAY_LIVE=false              # true only when taking real money; then sandbox webhooks are ignored
