# Copy to backend/.env for local development. Never commit real values.
APP_ENV=development            # production on Render
PORT=8080
DB_PATH=postgres://kladovki:kladovki_secret@localhost:5432/kladovki?sslmode=disable
JWT_SECRET=change-me-at-least-32-characters-long
JWT_TTL_HOURS=24

# ApiPay (Kaspi invoices). Webhook URL to set in ApiPay: https://<host>/api/v1/payments/webhook
APIPAY_KEY=
APIPAY_BASE_URL=https://api.apipay.kz/api
APIPAY_WEBHOOK_SECRET=         # "Создать секретный ключ подписи" in ApiPay; required outside development
APIPAY_LIVE=false              # true only when taking real money; then sandbox webhooks are ignored

# Public URL of the app (links in notifications, Telegram webhook)
APP_BASE_URL=https://kladovki.onrender.com

# --- Notifications: every channel is optional; unset = disabled ---
# Email (SMTP). Free for testing: Gmail + app password → smtp.gmail.com:587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Кладовки <noreply@example.kz>"

# Telegram bot (free): create with @BotFather; webhook is registered on startup
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=          # without @
TELEGRAM_WEBHOOK_SECRET=        # any random string, letters/digits/_-

# SMS via Mobizon (mobizon.kz) — paid per SMS
MOBIZON_API_KEY=

# WhatsApp via Green API (green-api.com) — free developer plan for testing
GREENAPI_INSTANCE_ID=
GREENAPI_TOKEN=
